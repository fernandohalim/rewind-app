# Copy to .env.local for development, and set the same names in Vercel.

# Spotify app (developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Dev: http://127.0.0.1:3000/api/auth/callback  Prod: https://<project>.vercel.app/api/auth/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
# Your Spotify user id; the only account allowed in
ALLOWED_SPOTIFY_ID=

# Random strings, at least 32 characters each
SESSION_SECRET=
CRON_SECRET=

# Firebase service account JSON, base64-encoded (one line)
FIREBASE_SERVICE_ACCOUNT=

# Level 5 enrichment (M5)
LASTFM_API_KEY=
# App name, version and a contact, e.g. "Rewind/0.1 ( you@example.com )"
MB_USER_AGENT=
